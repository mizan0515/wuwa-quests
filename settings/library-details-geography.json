chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/54d337cb5fe48616.html"},"지역_도감:geographyhandbook:1013":{"id":"지역_도감:geographyhandbook:1013","entry_id":"1013","title":"힘의 각주","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「힘겨루기와 불꽃의 교차, 호흡이 승패보다 우선이다」","alias_ids":["지역_도감:geographyhandbook:1013"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/4f0d813a88487453.html"},"지역_도감:geographyhandbook:1014":{"id":"지역_도감:geographyhandbook:1014","entry_id":"1014","title":"머리에 솟은 뿔","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「똑바로 날 보라고! 내가 보고 싶었던 건 바로 지금 너의 그 표정이었으니까. 질투에 일그러진 그 표정 말이야」","alias_ids":["지역_도감:geographyhandbook:1014"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/d46554cf3dc1388a.html"},"지역_도감:geographyhandbook:1015":{"id":"지역_도감:geographyhandbook:1015","entry_id":"1015","title":"발맞춰 추는 춤","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「모든 것을 잊었지만, 당신과 엇갈린 발걸음은 잊지 않는다」","alias_ids":["지역_도감:geographyhandbook:1015"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/ec321aa80ee1e97b.html"},"지역_도감:geographyhandbook:1016":{"id":"지역_도감:geographyhandbook:1016","entry_id":"1016","title":"조약돌","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「꾸꾸까까! 아무도 이해할 수 없어, 아무도 못 가져가, 아무도 속하지 않는다!」","alias_ids":["지역_도감:geographyhandbook:1016"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/93570b0e0ad809f1.html"},"지역_도감:geographyhandbook:1017":{"id":"지역_도감:geographyhandbook:1017","entry_id":"1017","title":"스켈캔스와 레밍","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「아브, 우리는 자연을 위해 어떤 결정도 할 필요가 없어」","alias_ids":["지역_도감:geographyhandbook:1017"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/ed841ad03d7fba98.html"},"지역_도감:geographyhandbook:1018":{"id":"지역_도감:geographyhandbook:1018","entry_id":"1018","title":"설원의 후예","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「바람이 깃털을 스쳤고 코고는 소리로 응답한다」","alias_ids":["지역_도감:geographyhandbook:1018"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/f1a2b725314c0c3c.html"},"지역_도감:geographyhandbook:1019":{"id":"지역_도감:geographyhandbook:1019","entry_id":"1019","title":"소생의 숲","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「지하에게 빛과 열을 가져오고, 언 땅에게 생기를 불러온다」","alias_ids":["지역_도감:geographyhandbook:1019"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/840edb144fc5000d.html"},"지역_도감:geographyhandbook:1020":{"id":"지역_도감:geographyhandbook:1020","entry_id":"1020","title":"멀고먼 푸르름","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「수 천 년 만에 돋아난 싹」","alias_ids":["지역_도감:geographyhandbook:1020"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/9e06e35e977a4b97.html"},"지역_도감:geographyhandbook:1021":{"id":"지역_도감:geographyhandbook:1021","entry_id":"1021","title":"따스한 모퉁이","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「당신들은 이곳에서 기나긴 겨울을 보냈었다」","alias_ids":["지역_도감:geographyhandbook:1021"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/0ef6117c8462409a.html"},"지역_도감:geographyhandbook:1022":{"id":"지역_도감:geographyhandbook:1022","entry_id":"1022","title":"추락한 눈동자","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「과거에 인류는 이를 통해 우주를 바라봤었다」","alias_ids":["지역_도감:geographyhandbook:1022"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/1afa7f048a8fcc26.html"},"지역_도감:geographyhandbook:1023":{"id":"지역_도감:geographyhandbook:1023","entry_id":"1023","title":"잠든 거대한 그림자","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「그것의 철발굽은 수많은 엑소스웜을 엑소스트라이더한테로 데려다줬다. 그러나 지금, 그것의 돌아가는 길은 이미 눈으로 뒤덮였다」","alias_ids":["지역_도감:geographyhandbook:1023"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/e5fee452550fde21.html"},"지역_도감:geographyhandbook:1024":{"id":"지역_도감:geographyhandbook:1024","entry_id":"1024","title":"떠도는 집념","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「그것은 우주를 떠도는 먼지가 되고 싶어 한다」","alias_ids":["지역_도감:geographyhandbook:1024"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/b15c1193f1ed878b.html"},"지역_도감:geographyhandbook:1025":{"id":"지역_도감:geographyhandbook:1025","entry_id":"1025","title":"얼어붙은 항로","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「영원한 엔진은 영원한 질서를 결정한다」","alias_ids":["지역_도감:geographyhandbook:1025"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/17653df84b0b7c80.html"},"지역_도감:geographyhandbook:1026":{"id":"지역_도감:geographyhandbook:1026","entry_id":"1026","title":"굳어버린 욕망","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「왕좌에 앉으려는 자 추위에 이겨내... 아, 나 좀 잡아당겨줘! 엉덩이가 얼어붙어서 일어날 수가 없어!」","alias_ids":["지역_도감:geographyhandbook:1026"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/d7cb9b21bb2d3d3a.html"},"지역_도감:geographyhandbook:1027":{"id":"지역_도감:geographyhandbook:1027","entry_id":"1027","title":"척추, 생명선","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「검을 척추로 하여 하늘과 땅을 연결하는 생명선이 되리라」","alias_ids":["지역_도감:geographyhandbook:1027"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/6b5e78cb360cede9.html"},"지역_도감:geographyhandbook:1028":{"id":"지역_도감:geographyhandbook:1028","entry_id":"1028","title":"눈으로 덮인 고향","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「실빛 고리의 푸른 열매에 하얀 눈이 내려앉아도, 귀환의 길은 여전히 기억하고 있다」","alias_ids":["지역_도감:geographyhandbook:1028"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/3aede3d1fb077565.html"},"지역_도감:geographyhandbook:1029":{"id":"지역_도감:geographyhandbook:1029","entry_id":"1029","title":"별바다의 옛 소원","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「사라지기 전에 그는 별바다를 다 보았었다」","alias_ids":["지역_도감:geographyhandbook:1029"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/6fff4d7843935e89.html"},"지역_도감:geographyhandbook:1030":{"id":"지역_도감:geographyhandbook:1030","entry_id":"1030","title":"영원한 겨울, 선구자","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「봄이 없는 들판에서 뒤따라 오는 자에게 길을 안내한다」","alias_ids":["지역_도감:geographyhandbook:1030"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/fee639e51df9a17a.html"},"지역_도감:geographyhandbook:1031":{"id":"지역_도감:geographyhandbook:1031","entry_id":"1031","title":"금빛 가지 새싹","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「시간과 고독을 자양분 삼아, 빛의 결실을 맺는다」","alias_ids":["지역_도감:geographyhandbook:1031"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/eda5d4bd5fb56307.html"},"지역_도감:geographyhandbook:1032":{"id":"지역_도감:geographyhandbook:1032","entry_id":"1032","title":"되찾은 낙원","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「당신들은 선조들의 업보를 짊어질 필요가 없다」","alias_ids":["지역_도감:geographyhandbook:1032"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/d38945bc9be31b06.html"},"지역_도감:geographyhandbook:1033":{"id":"지역_도감:geographyhandbook:1033","entry_id":"1033","title":"호기심 척도","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「한입에 다 못 먹는다는 건, 입이 더 커야 한다는 소리지!」","alias_ids":["지역_도감:geographyhandbook:1033"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/6bffc9149164429e.html"},"지역_도감:geographyhandbook:1034":{"id":"지역_도감:geographyhandbook:1034","entry_id":"1034","title":"어둠 속 반짝임","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「눈에 띄는 것은 위험한 법이다. 그들에게는 기다림 그 자체도 사냥이기 때문이다」","alias_ids":["지역_도감:geographyhandbook:1034"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/bf6dbaeb77cb0954.html"},"지역_도감:geographyhandbook:1035":{"id":"지역_도감:geographyhandbook:1035","entry_id":"1035","title":"겨울을 넘긴 날개","category":"지역_도감","category_label":"지역 도감","group":"world","chunk":"geography","role_id":null,"role_name":"","term_ids":[],"excerpt":"「그것은 날개를 펼쳐, 수천 년 만의 새벽녘을 맞이한다」","alias_ids":["지역_도감:geographyhandbook:1035"],"chapters":[],"related_item":null,"duplicate_count":1,"page":"/sources/745d4d8441f4c72e.html"}}