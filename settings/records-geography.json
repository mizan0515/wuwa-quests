book:1027":{"id":"지역_도감:geographyhandbook:1027","entry_id":"1027","category":"지역_도감","title":"척추, 생명선","db":"db_handbook.db","table":"geographyhandbook","role_id":null,"related_item_id":null,"sort":null,"values":[{"field":"name","field_index":3,"text_id":"GeographyRound_1027_Name","raw":"척추, 생명선","text":"척추, 생명선","status":"OK","locale_db":"ko/lang_multi_text.db","term_ids":[]},{"field":"region","field_index":5,"text_id":"","raw":"","text":"","status":"NO_REFERENCE","locale_db":"","term_ids":[]},{"field":"description","field_index":6,"text_id":"GeographyRound_1027_Descrtption","raw":"「검을 척추로 하여 하늘과 땅을 연결하는 생명선이 되리라」","text":"「검을 척추로 하여 하늘과 땅을 연결하는 생명선이 되리라」","status":"OK","locale_db":"ko/lang_multi_text.db","term_ids":[]}]},"지역_도감:geographyhandbook:1028":{"id":"지역_도감:geographyhandbook:1028","entry_id":"1028","category":"지역_도감","title":"눈으로 덮인 고향","db":"db_handbook.db","table":"geographyhandbook","role_id":null,"related_item_id":null,"sort":null,"values":[{"field":"name","field_index":3,"text_id":"GeographyRound_1028_Name","raw":"눈으로 덮인 고향","text":"눈으로 덮인 고향","status":"OK","locale_db":"ko/lang_multi_text.db","term_ids":[]},{"field":"region","field_index":5,"text_id":"","raw":"","text":"","status":"NO_REFERENCE","locale_db":"","term_ids":[]},{"field":"description","field_index":6,"text_id":"GeographyRound_1028_Descrtption","raw":"「실빛 고리의 푸른 열매에 하얀 눈이 내려앉아도, 귀환의 길은 여전히 기억하고 있다」","text":"「실빛 고리의 푸른 열매에 하얀 눈이 내려앉아도, 귀환의 길은 여전히 기억하고 있다」","status":"OK","locale_db":"ko/lang_multi_text.db","term_ids":[]}]},"지역_도감:geographyhandbook:1029":{"id":"지역_도감:geographyhandbook:1029","entry_id":"1029","category":"지역_도감","title":"별바다의 옛 소원","db":"db_handbook.db","table":"geographyhandbook","role_id":null,"related_item_id":null,"sort":null,"values":[{"field":"name","field_index":3,"text_id":"GeographyRound_1029_Name","raw":"별바다의 옛 소원","text":"별바다의 옛 소원","status":"OK","locale_db":"ko/lang_multi_text.db","term_ids":[]},{"field":"region","field_index":5,"text_id":"","raw":"","text":"","statu